# ---- Build output ----
/target/
**/target/
build/
dist/
captures/
graphify-out/
*.bin
*.cue
*.exe
*.elf
*.map

# ---- BRING YOUR OWN ASSETS ----
# Never commit Half-Life assets or anything derived from them. Point the
# extractor at your own Half-Life install (Steam/retail). Source assets and
# everything cooked from them stay local only.
data/
assets/
*.wad
*.bsp
*.mdl
*.spr
*.pak
*.gcf
# Cooked PS1-native maps (derived from your BSPs).
*.hlm

# Local machine config (e.g. HL_DIR override pointing at your install).
config.mk

# ---- Local-only material (kept on disk, never committed) ----
docs/
reference/
tools/*.py
!tools/memory_report.py
!tools/campaign_map_report.py
!tools/campaign_flow_report.py
!tools/roster_audit.py
!tools/merge_model_chunk.py
# Asset extractors needed by `make assets` (they read YOUR Half-Life install
# and contain no Valve data, so a fresh clone can build).
!tools/extract_menu.py
!tools/extract_music.py
!tools/extract_sfx.py
!tools/extract_voices.py
!tools/extract_sprites.py
!tools/gen_clips_manifest.py
tools/*.sh

# ---- OS / editor cruft ----
.DS_Store
