  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=573 timeout=60
  1 f-127 jump
  1 f-127
  6 f-127 duck
  4 f-127 duck
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=292 timeout=240
  @checkpoint pipes-crossed
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=270 value_hi=300
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=between value=620 value_hi=650
  2 f127
  80
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=228 timeout=120
  1 f127
  5
  3 s-127
  1 s127
  5
  @face 3925 left
  3 use
  100
  @face 1024 right
  @hold s40 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=626 timeout=60
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=96 timeout=180
  @checkpoint lobby-west
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=60 value_hi=110
  @hold s-40 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=622 timeout=100
  @hold f40 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=140 timeout=100
  @face 508 left
  @checkpoint elevator-lobby
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=148 value_hi=168
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=between value=622 value_hi=640
  # Known parity bug, not yet a journey step: the call button here (ele_2) does not carry the player in the port.
  # In retail the next steps are: ride the lift to z -100, wait for the console scientist, open the retinal door at (770, 246),
  # cross the control room beams at (919, 788) and leave by the changelevel at (574, 984).
  @stop


