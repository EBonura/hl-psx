map c1a0e next c1a0c
  @checkpoint arrive-c1a0e
  @assert sym=LOGIC_PLAYER_SUIT size=1 op=eq value=1
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=ge value=100
