  # Closed loop to the ladder. The catwalk above it has a hole 45 units wide (x 2142..2187)
  # and 72 long (y 687..759); the player hull is 32 wide, so the climb only clears the
  # catwalk when the player mounts near the middle of the ladder (y 703..743). The oracle
  # route lands there by luck of its approach; the PS1 approach arrives 30 units off.
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed offset=8 op=le value=790 timeout=900
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=ge value=2100 timeout=900
  @hold s40 until sym=LOGIC_PLAYER_POS size=4 signed offset=8 op=le value=722 timeout=900
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=ge value=2158 timeout=900
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed offset=4 op=ge value=150 timeout=900
  2 f-127
  20
  30 s127
  2 s-127
  8
  20 f-127 s127
  2 f127 s-127
  8
  16 t127
  5
  # PlayerUse only accepts a target inside a 45 degree cone (normalised dot > 0.7, the
  # oracle rejects the same press at 0.4). The PS1 stands 5 units east and 7 south of the
  # oracle here and the button is 30 below the eye, so look down about 17 degrees first.
  2 l-127
  3 use
  2 l127
  16 t-127
  1776
  20 f127
  22 s-127
  1 f-127
  1 f127
  3
  2 s-127
  11 l-127
  55 f127
  11 l127
  10
  # The oracle route walks open loop to the sample cart, which the PS1 reaches 46 units off
  # the oracle line. Walk the same world path as waypoints (yaw stays east, so forward is +x
  # and strafe right is -y), then push the cart east from its west face. The cart's box is
  # x 1181..1315, y 588..652 and the beam trigger it must enter starts at x 1522.
  @hold f-127 s-127 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=le value=1985 timeout=900
  @checkpoint w1
  @hold f-127 s-100 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=le value=1912 timeout=900
  @hold f-127 s-13 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=le value=1740 timeout=900
  @checkpoint w3
  @hold f-127 s78 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=le value=1540 timeout=900
  @checkpoint w4
  @hold f-127 s20 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=le value=1285 timeout=900
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=le value=1225 timeout=900
  @checkpoint w5
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed offset=8 op=le value=642 timeout=900
  @checkpoint w6
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=le value=1162 timeout=900
  @checkpoint w7
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed offset=8 op=le value=620 timeout=900
  @checkpoint w8
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=ge value=1385 timeout=900
  @checkpoint cart-pushed
  @assert sym=LOGIC_PLAYER_SUIT size=1 op=eq value=1
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=1 value_hi=100
  # The cart enters the beam trigger (probe_arm_mm), the arms lower and the cascade runs
  # on its own; the changelevel to c1a0c follows about 1300 simulation ticks later.
  @wait sym=WORLD_ARENA offset=4 size=4 op=eq value=5816 timeout=30000

map c1a0c next c1a1
  # The cascade's fade-in covers the first moments after the load.
  100
  @checkpoint arrive-c1a0c
  @assert sym=LOGIC_PLAYER_SUIT size=1 op=eq value=1
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=1 value_hi=100
  @stop
  50
  10 s127
  3
  60 s127 jump
  5
  # The oracle line stalls at a hop near x 1340 and stops at x 1631 when its run ends; the
  # PS1 does not stall, so the open-loop x run overshoots. Same world path, closed loop.
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=ge value=1300 timeout=900
  3
  @hold f127 jump until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=ge value=1600 timeout=900
  2 f-127
  8
  @checkpoint c-p1
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed offset=8 op=le value=85 timeout=900
  5
