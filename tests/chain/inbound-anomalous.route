  20
  # Closed loop to the ladder. The catwalk above it has a hole 45 units wide (x 2142..2187)
  # and 72 long (y 687..759); the player hull is 32 wide, so the climb only clears the
  # catwalk when the player mounts near the middle of the ladder (y 703..743). The oracle
  # route lands there by luck of its approach; the PS1 approach arrives 30 units off.
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed offset=8 op=le value=790 timeout=900
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=ge value=2100 timeout=900
  @hold s40 until sym=LOGIC_PLAYER_POS size=4 signed offset=8 op=le value=722 timeout=900
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=ge value=2158 timeout=900
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed offset=4 op=ge value=150 timeout=900
  2 f-127
  20
  30 s127
  2 s-127
  8
  20 f-127 s127
  2 f127 s-127
  8
  16 t127
  5
  # PlayerUse only accepts a target inside a 45 degree cone (normalised dot > 0.7, the
  # oracle rejects the same press at 0.4). The PS1 stands 5 units east and 7 south of the
  # oracle here and the button is 30 below the eye, so look down about 17 degrees first.
  2 l-127
  3 use
  2 l127
  16 t-127
  1776
  20 f127
  22 s-127
  1 f-127
  1 f127
  3
  2 s-127
  11 l-127
  55 f127
  11 l127
  10
  # The oracle route walks open loop to the sample cart, which the PS1 reaches 46 units off
  # the oracle line. Walk the same world path as waypoints (yaw stays east, so forward is +x
  # and strafe right is -y), then push the cart east from its west face. The cart's box is
  # x 1181..1315, y 588..652 and the beam trigger it must enter starts at x 1522.
  @hold f-127 s-127 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=le value=1985 timeout=900
  @checkpoint w1
  @hold f-127 s-100 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=le value=1912 timeout=900
  @hold f-127 s-13 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=le value=1740 timeout=900
  @checkpoint w3
  # The next leg squeezes past the lift's rail: the x where the leg starts differs by about 30 units between a
  # build with and without the intro stage, and with it the y at the end of the leg (766 or 1034). Centre y first.
  @align s-40 sym=LOGIC_PLAYER_POS size=4 signed offset=8 lo=1056 hi=1072 timeout=60
  @hold f-127 s78 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=le value=1540 timeout=900
  @checkpoint w4
  @hold f-127 s20 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=le value=1285 timeout=900
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=le value=1225 timeout=900
  @checkpoint w5
  # The cart push is closed loop. The cart is a 64 unit box on a rail centred at y 620, its beam trigger starts at
  # x 1522 (cart origin 1510), and the player hull only reaches the cart's west face from the lift's west margin
  # (x 1152..1163, between the wall and the lift lip). Every hold below ends at once when its condition already
  # holds, so each pair is a dead band, not a fixed nudge, and a hold times out only when the player is blocked:
  #   ENT_CACHE+1732 and +1740 are the origin x and y of entity 27, the sample cart (64 byte Ent, origin at +4)
  #   yaw 1010..1038  east is 1024 and the smallest turn the stick can make is 29 per tick (2.5 degrees)
  #   walk west along y >= 700 (north of the lift and of the cart's hull) to the margin, then strafe south along it
  #   settle 8 ticks after each strafe so no lateral speed is left, then fine bands on the player's y
  #   push in legs terminated by the cart's own x (ENT_CACHE origin x), first leg at forward 60: a full-speed
  #   start flush against the lift lip can stall 3 units short of the cart on builds before the slide_move fix
  @hold t-29 until sym=LOGIC_PLAYER_YAW size=2 op=le value=1038 timeout=300
  @hold t29 until sym=LOGIC_PLAYER_YAW size=2 op=ge value=1010 timeout=300
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed offset=8 op=ge value=700 timeout=300
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=le value=1162 timeout=400
  @hold t-29 until sym=LOGIC_PLAYER_YAW size=2 op=le value=1038 timeout=300
  @hold t29 until sym=LOGIC_PLAYER_YAW size=2 op=ge value=1010 timeout=300
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed offset=8 op=le value=650 timeout=600
  8
  @hold s40 until sym=LOGIC_PLAYER_POS size=4 signed offset=8 op=le value=628 timeout=300
  @hold s-40 until sym=LOGIC_PLAYER_POS size=4 signed offset=8 op=ge value=612 timeout=300
  8
  @hold s40 until sym=LOGIC_PLAYER_POS size=4 signed offset=8 op=le value=626 timeout=300
  @hold s-40 until sym=LOGIC_PLAYER_POS size=4 signed offset=8 op=ge value=614 timeout=300
  8
  @checkpoint cart-aligned
  @assert sym=ENT_CACHE size=4 signed offset=1740 op=between value=610 value_hi=630
  @assert sym=LOGIC_PLAYER_POS size=4 signed offset=8 op=between value=590 value_hi=650
  @hold t-29 until sym=LOGIC_PLAYER_YAW size=2 op=le value=1038 timeout=300
  @hold t29 until sym=LOGIC_PLAYER_YAW size=2 op=ge value=1010 timeout=300
  @hold f60 until sym=ENT_CACHE size=4 signed offset=1732 op=ge value=1312 timeout=200
  @hold t-29 until sym=LOGIC_PLAYER_YAW size=2 op=le value=1038 timeout=300
  @hold t29 until sym=LOGIC_PLAYER_YAW size=2 op=ge value=1010 timeout=300
  @hold f127 until sym=ENT_CACHE size=4 signed offset=1732 op=ge value=1342 timeout=200
  @hold t-29 until sym=LOGIC_PLAYER_YAW size=2 op=le value=1038 timeout=300
  @hold t29 until sym=LOGIC_PLAYER_YAW size=2 op=ge value=1010 timeout=300
  @hold f127 until sym=ENT_CACHE size=4 signed offset=1732 op=ge value=1372 timeout=200
  @hold t-29 until sym=LOGIC_PLAYER_YAW size=2 op=le value=1038 timeout=300
  @hold t29 until sym=LOGIC_PLAYER_YAW size=2 op=ge value=1010 timeout=300
  @hold f127 until sym=ENT_CACHE size=4 signed offset=1732 op=ge value=1402 timeout=200
  @hold t-29 until sym=LOGIC_PLAYER_YAW size=2 op=le value=1038 timeout=300
  @hold t29 until sym=LOGIC_PLAYER_YAW size=2 op=ge value=1010 timeout=300
  @hold f127 until sym=ENT_CACHE size=4 signed offset=1732 op=ge value=1432 timeout=200
  @hold t-29 until sym=LOGIC_PLAYER_YAW size=2 op=le value=1038 timeout=300
  @hold t29 until sym=LOGIC_PLAYER_YAW size=2 op=ge value=1010 timeout=300
  @hold f127 until sym=ENT_CACHE size=4 signed offset=1732 op=ge value=1462 timeout=200
  @hold t-29 until sym=LOGIC_PLAYER_YAW size=2 op=le value=1038 timeout=300
  @hold t29 until sym=LOGIC_PLAYER_YAW size=2 op=ge value=1010 timeout=300
  @hold f127 until sym=ENT_CACHE size=4 signed offset=1732 op=ge value=1492 timeout=200
  @hold t-29 until sym=LOGIC_PLAYER_YAW size=2 op=le value=1038 timeout=300
  @hold t29 until sym=LOGIC_PLAYER_YAW size=2 op=ge value=1010 timeout=300
  @hold f127 until sym=ENT_CACHE size=4 signed offset=1732 op=ge value=1516 timeout=200
  @checkpoint cart-delivered
  @assert sym=ENT_CACHE size=4 signed offset=1732 op=between value=1516 value_hi=1700
  @assert sym=ENT_CACHE size=4 signed offset=1740 op=between value=590 value_hi=650
  @checkpoint cart-pushed
  @assert sym=LOGIC_PLAYER_SUIT size=1 op=eq value=1
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=1 value_hi=100
  # The cart enters the beam trigger (probe_arm_mm), the arms lower and the cascade runs
  # on its own; the changelevel to c1a0c follows about 1300 simulation ticks later.
  @wait sym=WORLD_ARENA offset=4 size=4 op=eq value=5816 timeout=30000

map c1a0c next c1a1
  # The cascade's fade-in covers the first moments after the load.
  100
  @checkpoint arrive-c1a0c
  @assert sym=LOGIC_PLAYER_SUIT size=1 op=eq value=1
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=1 value_hi=100
  50
  10 s127
  3
  60 s127 jump
  5
  # The oracle line stalls at a hop near x 1340 and stops at x 1631 when its run ends; the
  # PS1 does not stall, so the open-loop x run overshoots. Same world path, closed loop.
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=ge value=1300 timeout=900
  3
  @hold f127 jump until sym=LOGIC_PLAYER_POS size=4 signed offset=0 op=ge value=1600 timeout=900
  2 f-127
  8
  @checkpoint c-p1
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed offset=8 op=le value=85 timeout=900
  5
  # The barrier at y 40..64 is 23 units high: the oracle jumps it from a standstill at y 80
  # and walks across its top; the same input does it here.
  25 s127 jump
  @checkpoint c-p2
  5
  7 s-127
  1 s127
  5
  9 f-127
  1 f127
  5
  @checkpoint c-p3
  16 t127
  3 use
  @checkpoint c-u1
  220
  @face 1024 left
  5
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=-176 timeout=92
  1 s-127
  5
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=994 timeout=200
  2 f127
  5
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=432 timeout=240
  5
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=878 timeout=80
  1 f-127
  5
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=629 timeout=112
  1 s127
  5
  @hold f-127 jump until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=579 timeout=240
  5
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=573 timeout=60
  1 f-127 jump
  1 f-127
  6 f-127 duck
  4 f-127 duck
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=292 timeout=240
  @checkpoint pipes-crossed
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=270 value_hi=300
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=between value=605 value_hi=650
  # The door ahead (edoor_2) is only 30 units wider than the player and the jump lands anywhere in a 30 unit y range
  # depending on the build's timing: centre on the doorway before pushing into it.
  @align s-40 sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 lo=630 hi=648 timeout=60
  2 f127
  80
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=228 timeout=120
  1 f127
  5
  3 s-127
  1 s127
  5
  @face 3925 left
  100
  @face 1024 right
  @hold s40 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=626 timeout=60
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=96 timeout=180
  @checkpoint lobby-west
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=60 value_hi=110
  @hold s-40 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=622 timeout=100
  @hold f40 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=140 timeout=100
  @face 508 left
  @checkpoint elevator-lobby
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=148 value_hi=168
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=between value=618 value_hi=656
  3 use
  @checkpoint lift-called
  120
  @checkpoint lift-top
  @probe
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=4 op=between value=-110 value_hi=-90
  @face 1018 left
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=480 timeout=92
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=152 timeout=60
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=162 timeout=60
  20
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=204 timeout=132
  2 s-127
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=80 timeout=100
  # A full-stick hold leaves the player sliding for about 50 units after the stick is released, so the
  # position read at the end of the hold is not where he stops (and the scientist's use cone is only
  # 45 degrees). Settle, then close the last stretch with a slow approach and settle again.
  # The strafe leg slid 20 to 30 units past y 80 on this build and the scientist's spot is not free at y 52: settle in the
  # scanner's lane first (facing +x, strafe right lowers y).
  @align s-40 sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 lo=68 hi=78 timeout=100
  @align f40 sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 lo=152 hi=168 timeout=120
  @checkpoint console-room
  @probe
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=150 value_hi=170
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=between value=66 value_hi=96
  650
  @face 2050 right
  3 use
  10
  @face 1018 left
  5
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=276 timeout=116
  1 s127
  5
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=560 timeout=220
  1 f-127
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=252 timeout=60
  1 s-127
  5
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=800 timeout=220
  2 f-127
  # The scientist follows the player to the scanner and takes the sequence there; its door (entity 64) swings open.
  @wait sym=ENT_PHASE offset=256 size=4 op=ge value=4096 timeout=1500
  @checkpoint retinal-door-open
  @probe
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=194 timeout=100
  1 s-127
  5
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=838 timeout=100
  1 f-127
  5
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=276 timeout=100
  1 s127
  5
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=950 timeout=100
  1 f-127
  5
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=926 timeout=80
  1 f127
  5
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=918 timeout=40
  1 f-127
  5
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=802 timeout=240
  2 s127
  @checkpoint control-room-beams
  @probe
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=1 value_hi=100
  # The beams end with an explosion of 70 at the control-room door (`control_door_shatter`, radius 175, and a harmless one of 150) that
  # costs 48 health to a player standing in front of it and throws him back. Wait it out more than 175 units from it (y 836 - 175),
  # then come back to a door that has gone.
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=650 timeout=120
  @checkpoint control-room-south
  @probe
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=0 value_hi=100
  300
  @checkpoint control-room-waited
  @probe
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=0 value_hi=100
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=806 timeout=120
  # Centre on the doorway of the control-room door (opening x 908..936 once its breakables are gone) before leaning on it.
  # Keep the hull out of the beam hurt volumes (`1_control_beam_hurt` reaches y 784, the hull is 16 either side) and square up in
  # front of the door (its plane is at y 836): y 808 to 818, then x 916 to 930 (the opening is 28 wide), then y again.
  @align s-40 sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 lo=808 hi=818 timeout=100
  @align f40 sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 lo=916 hi=930 timeout=100
  @align s-40 sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 lo=808 hi=818 timeout=100
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=938 timeout=6000
  1 s127
  5
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=590 timeout=200


map c1a1 next c1a1a
  @checkpoint arrive-c1a1
  @assert sym=LOGIC_PLAYER_SUIT size=1 op=eq value=1
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=1 value_hi=100
  20
