  2 f127 s-127
  8
  16 t127
  5
  # PlayerUse only accepts a target inside a 45 degree cone (normalised dot > 0.7, the
  # oracle rejects the same press at 0.4). The PS1 stands 5 units east and 7 south of the
  # oracle here and the button is 30 below the eye, so look down about 17 degrees first.
  2 l-127
  3 use
  2 l127
  16 t-127
  1776
  20 f127
  22 s-127
  1 f-127
  1 f127
  3
