@journey name=hl-parity-c1a3a-grunt-cover title="Half-Life c1a3a marine cover: the marine from the west catwalk comes down at the player, and a pistol hit while it is not charging or kicking sends it to a spot hidden from the player, where it holds" prologue=segment segment_row=24 sync=poll max_ticks=40000
# CHGrunt::GetSchedule on light damage takes cover from the enemy (TAKE_COVER_FROM_ENEMY: FindLateralCover, then FindCover over the
# nodes) 9 times in 10; the tenth flinches. The marine in slot 5 (HL 576, -2016 on the west catwalk) sees the player in the hall by
# the pillar (x 864, y -1855), runs down and kicks; it is a charger (odd slot), so its timer has bit 7 set while it charges or kicks
# (modes 0..2) and a hit then starts no search. The route waits for the timer to clear and shoots once; a hit that flinched or found
# no cover is followed by another, at most three in all (6 pistol hits kill it). Cover is timer mode 3 (bits 5..7 all set) with the
# spot in PROP_SCRIPT_GOAL; the marine's own sight bit (PROP_OCC_VIS bit 1) clearing at the spot is the game's sight test from it to
# the player. The player stands still from the first shot. Walk: the crates (func_breakable *99/*100 and *8/*9) are passed on the
# x 886 and x 812 gaps; the pillar row starts at y -1860.
map c1a3a next x
  @wait expr="i32(LOGIC_PLAYER_POS[2]) != 0" timeout=200
  20
  @face 2048 right
  @hold s-127 until x>=860 timeout=60
  @align s-40 sym=LOGIC_PLAYER_POS offset=0 signed=true lo=880 hi=896 timeout=200
  @hold f127 until y<=-1290 timeout=200
  @hold s127 until x<=830 timeout=60
  @align s-40 sym=LOGIC_PLAYER_POS offset=0 signed=true lo=800 hi=824 timeout=200
  @hold f127 until y<=-1800 timeout=200
  @hold f70 until y<=-1835 timeout=60
  @face 1024 left
  @hold f70 until x>=840 timeout=60
  @align f40 sym=LOGIC_PLAYER_POS offset=0 signed=true lo=856 hi=872 timeout=200
  @checkpoint by-pillar
  @probe
  @aim prop=5 timeout=150
  @checkpoint aimed
  @probe
  @assert expr="u8(PROP_HEALTH[5]) == 50"
  @wait expr="u8(PROP_AI_TIMER[5]) < 128 || u8(PROP_AI_TIMER[5]) >= 224" timeout=100
  @hold attack until expr="u8(PROP_HIT_FLASH[5]) != 0 || u8(PROP_AI_TIMER[5]) >= 224" timeout=120
  @wait expr="u8(PROP_HIT_FLASH[5]) == 0 || u8(PROP_AI_TIMER[5]) >= 224" timeout=100
  @wait expr="u8(PROP_AI_TIMER[5]) < 128 || u8(PROP_AI_TIMER[5]) >= 224" timeout=100
  @hold attack until expr="u8(PROP_HIT_FLASH[5]) != 0 || u8(PROP_AI_TIMER[5]) >= 224" timeout=120
  @wait expr="u8(PROP_HIT_FLASH[5]) == 0 || u8(PROP_AI_TIMER[5]) >= 224" timeout=100
  @wait expr="u8(PROP_AI_TIMER[5]) < 128 || u8(PROP_AI_TIMER[5]) >= 224" timeout=100
  @hold attack until expr="u8(PROP_HIT_FLASH[5]) != 0 || u8(PROP_AI_TIMER[5]) >= 224" timeout=120
  @wait expr="u8(PROP_AI_TIMER[5]) >= 224" timeout=20
  @checkpoint takes-cover
  @probe
  @assert expr="u8(PROP_HEALTH[5]) > 0"
  @assert expr="(let dx = i32(PROP_POS[15]) - i16(PROP_SCRIPT_GOAL[15]), dy = i32(PROP_POS[17]) - i16(PROP_SCRIPT_GOAL[17]) in dx * dx + dy * dy) > 1024"
  @wait expr="(let dx = i32(PROP_POS[15]) - i16(PROP_SCRIPT_GOAL[15]), dy = i32(PROP_POS[17]) - i16(PROP_SCRIPT_GOAL[17]) in dx * dx + dy * dy) <= 576" timeout=60
  @wait expr="(u8(PROP_OCC_VIS[5]) & 2) == 0" timeout=40
  @checkpoint in-cover
  @assert expr="u8(PROP_AI_TIMER[5]) >= 224"
  20
  @checkpoint holds
  @probe
  @assert expr="u8(PROP_AI_TIMER[5]) >= 224"
  @assert expr="(u8(PROP_OCC_VIS[5]) & 2) == 0"
  @assert expr="(let dx = i32(PROP_POS[15]) - i16(PROP_SCRIPT_GOAL[15]), dy = i32(PROP_POS[17]) - i16(PROP_SCRIPT_GOAL[17]) in dx * dx + dy * dy) <= 576"
  @assert expr="i16(LOGIC_PLAYER_HEALTH) > 0"
  @stop
