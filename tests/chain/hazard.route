@journey name=hl-chain-hazard title="Half-Life Hazard Course: title, Hazard Course row, t0a0 start corridor, doors td1 and td2, the observation hall, the catwalk, round the canal, the jump course and the duck course" prologue=hazard hazard_row=0 max_ticks=30000

# Work in progress, written against the Hazard Course start (t0a0). The course is a long scripted
# tutorial; this block gets the player from the start lift to the east end of the observation hall.
# Positions are LOGIC_PLAYER_POS (x, up, y); yaw 0 faces +y.
map t0a0 next t0a0a
  # The lift room opens on the player; the narrator speaks and the first pedestal stands in the middle.
  200
  @checkpoint hazard-start
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=-1390 value_hi=-1370
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=between value=-1975 value_hi=-1955
  # Walk to the pedestal (the button at y -1532 only starts a sentence), then round it on the east side.
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=-1570 timeout=300
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-1300 timeout=300
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=-1450 timeout=300
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=-1380 timeout=300
  # Door td1 opens 15 s after the player passes the trigger at y -1680; holding forward waits for it.
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=-1300 timeout=3000
  # The slide after the release is 20 to 30 units and the stair rails further on leave about 30 units of width:
  # settle and centre the player before the corridor instead of trusting where the hold ended.
  @align s40 sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 lo=-1392 hi=-1368 timeout=120
  @checkpoint td1-passed
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=between value=-1330 value_hi=-1190
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=-1396 value_hi=-1364
  # The corridor to door td2 (y -460), which opens on the trigger at y -636, then the observation hall.
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=-366 timeout=3000
  @checkpoint observation-hall
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=between value=-380 value_hi=-350
  # East along the rail, then the hall's north wall, then the opening at its east end.
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-1000 timeout=300
  30 f127
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-780 timeout=300
  @checkpoint hall-east-end
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=-790 value_hi=-740
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=between value=-330 value_hi=-290
  # North along the catwalk: along the east rail to y -100, left past the wall, then up the long grate
  # to the door of the swimming shaft (a ladder at x -692, y 778 is inside it).
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-640 timeout=100
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=-100 timeout=300
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=-640 timeout=100
  # The full-stick leg slides on by a build-dependent 20 to 60 units, and the gap in the wall ahead (y -96 to -56) starts at x -676:
  # settle inside it. Facing north, strafe right raises x.
  @align s40 sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 lo=-668 hi=-640 timeout=100
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=600 timeout=600
  @checkpoint catwalk-end
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=-790 value_hi=-700
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=between value=600 value_hi=640
  # The door ahead (waterout, y 648) opens only from its north side and the water canal east of it has a railing: the course goes
  # round the canal. East to the railing at x -413, north to the wall at y 931, east across the top of the canal, back south down its
  # east bank, then east through door td3 (opened by the trigger at x -132) into the corridor at y 500..628.
  60 s127
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=925 timeout=400
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-160 timeout=300
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=600 timeout=300
  @checkpoint canal-east-bank
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=-200 value_hi=-120
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-10 timeout=300
  @face 1024 right
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=555 timeout=100
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=100 timeout=300
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=600 timeout=500
  @checkpoint jump-course-entry
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=590 value_hi=660
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=between value=560 value_hi=660
  # The jump course: west to x 492, then north along the corridor. Three ridges (y 1168, 1424, 1680) are jumped from 46 units before
  # each; the shallow pits between them cost nothing.
  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=492 timeout=200
  # The yaw cannot be set closer than about 30 units to 1024, and every unit of error drifts the run 2 to 3 units sideways over the
  # 1200 units of corridor (the door td4 at its end is narrow): square up, then centre in the corridor after the leg that slides on
  # and again after the last ridge (a stop between ridges costs the run-up the jumps need).
  @face 960 right
  @align f40 sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 lo=480 hi=504 timeout=100
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=1100 timeout=400
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=1122 timeout=200
  2 s-127 jump
  12 s-127
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=1378 timeout=200
  2 s-127 jump
  12 s-127
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=1634 timeout=200
  2 s-127 jump
  12 s-127
  @align f40 sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 lo=476 hi=506 timeout=100
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=1990 timeout=400
  @checkpoint jump-course-done
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=between value=1985 value_hi=2030
  # Door td4 has opened on the trigger at y 1870. The duck course runs east along y 2200: walk to x 1120, then crouch (Triangle)
  # through the wells and low tunnels to x 1770, stand, and walk through door td5 (trigger at x 1868).
  @hold s-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=2150 timeout=400
  # The run east along the duck course needs a heading at or past 1024 (a yaw under it steers the player into the +y wall).
  # Where in the 60 unit face band the player stops depends on the build's frame timing: 1024 is green on the no-intro disc of this
  # layout, 990 (tuned on the previous layout) stalls at x 865; the intro disc needs its own check.
  @face 1024 right
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=900 timeout=300
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=1120 timeout=200
  @hold f127 duck until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=1770 timeout=600
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=1900 timeout=300
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=2100 timeout=600
  @checkpoint duck-course-done
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=2090 value_hi=2200
  @stop
