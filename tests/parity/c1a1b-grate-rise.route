  @checkpoint held
  @probe
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=40 value_hi=100
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=4 op=between value=-300 value_hi=-280
  # once the grate has slid clear the swimmer rises out of the hole
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=4 op=ge value=-240 timeout=300
  @checkpoint out
  @probe
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=1 value_hi=100
  @stop
