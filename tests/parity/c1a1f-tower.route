  @checkpoint c1a1f-east-room
  @probe
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=1 value_hi=100
  # The crab under the tower (prop 7, (-444,408)) is alive until the trigger fires.
  @assert sym=PROP_HEALTH offset=7 size=1 op=between value=1 value_hi=255
  @align s-40 sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 lo=508 hi=520 timeout=100
  @hold f-127 duck until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=-350 timeout=90
  @checkpoint c1a1f-vent-crawled
  @probe
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=1 value_hi=100
  # The trigger at x -342 tips the tower (90 degrees in 8 ticks, 250 deg/s); in the reference the crab is crushed on the step to 75 degrees.
  @wait sym=PROP_HEALTH offset=7 size=1 op=eq value=0 timeout=40
  @checkpoint c1a1f-tower-crushed
  @probe
  @assert sym=PROP_HEALTH offset=7 size=1 op=eq value=0
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=1 value_hi=100
