  @assert sym=PLAYER_WATER_LEVEL size=1 op=between value=0 value_hi=3
  @assert sym=LOGIC_PLAYER_YAW size=2 op=between value=0 value_hi=4095
  @assert sym=LOGIC_PLAYER_PITCH size=2 signed=true op=between value=-4096 value_hi=4095
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=4 op=ge value=-297 timeout=40
  @checkpoint grate-armed
  @probe
  @assert sym=TRAIN_OFF offset=14 size=2 signed=true op=between value=-260 value_hi=-250
  @assert sym=TRAIN_OFF offset=16 size=2 signed=true op=between value=-880 value_hi=-870
  # The trigger_once under the grate fires as the hull top reaches z -262; the train lifts 7 and slides to y -819 at 32 u/s.
  @wait sym=TRAIN_OFF offset=14 size=2 signed=true op=eq value=-247 timeout=40
  @checkpoint grate-lifted
  @probe
  @wait sym=TRAIN_OFF offset=16 size=2 signed=true op=ge value=-819 timeout=80
  @checkpoint grate-open
  @probe
  @assert sym=TRAIN_OFF offset=14 size=2 signed=true op=eq value=-247
  @assert sym=TRAIN_OFF offset=16 size=2 signed=true op=between value=-819 value_hi=-819
  @stop
