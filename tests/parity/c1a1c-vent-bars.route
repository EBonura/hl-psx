  @hold f127 duck until x<=-1004 timeout=60
  @checkpoint vent_w
  @probe
  # The bars (BSP models *133..*137, 1 unit thick, top flush with the vent floor) are cooked with a
  # crouch hull of their own. With only the standing hull a ducked player counted them as a wall at
  # x -945 (the first bar's hull edge) and was stopped there; the retail oracle (hl-chain ref/vcr)
  # crawls over them. Needs a data cook from host/hl-bsp with the low-brush hull 3 rule.
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=-1100 value_hi=-1004
  @stop
