  # the exit room holds the dead guard's pistol (weapon_glock -256,-984): walk over it (autopickup), then back to the corridor line
  @checkpoint c1a1f-pre-glock
  @probe
  @hold f70 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-262 timeout=40
  @hold f-38 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=-250 timeout=40
  10
  @hold s-90 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=-996 timeout=60
  @checkpoint c1a1f-glock
  @probe
  @assert sym=LOGIC_PLAYER_CLIP_AMMO size=2 op=ge value=1
  @hold s90 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=-1070 timeout=60
  @hold s-70 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=-1112 timeout=40
  @hold s70 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=-1056 timeout=40
  @hold f127 s-7 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-281 timeout=45
  @hold s-70 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=-1110 timeout=40
  @hold s70 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=-1054 timeout=40
  @hold f127 s-7 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-238 timeout=45
  @hold s-70 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=-1107 timeout=40
  @hold s70 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=-1051 timeout=40
  @hold f127 s-7 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-194 timeout=45
  @hold s-70 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=-1105 timeout=40
  @hold s70 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=-1049 timeout=40
  @hold f127 s-7 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-151 timeout=45
  @hold s-70 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=-1102 timeout=40
  @hold s70 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=-1046 timeout=40
  @hold f127 s-7 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-118 timeout=45
  @hold s-70 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=-1084 timeout=40
  @hold s70 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=-1060 timeout=40
  @hold f127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-90 timeout=40
  10
  # the hole is y -1084..-1072 for the hull origin and the PS1 clip edge sits a unit or two inside it: aim for the middle. Approach it from the north only:
  # a south-going hold slides about 6 units after it ends, a north-going one tens, so a dead-band pair cannot hit a 12 wide band
  # north standing (a slide there is harmless), then south crouched: a crouched player is a third as fast, so the slide after the hold is a few units, and the hull is already low at the hole
  @hold s-70 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=-1060 timeout=60
  6
  @hold s45 duck until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=-1073 timeout=80
  8 duck
  @checkpoint c1a1f-pre-crawl
  @probe
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=1 value_hi=100
  # crouch first and settle, then crawl: a hull still standing when it reaches the hole stops at the wall (m1i)
  12 duck
  # the hole is y -1084..-1072: settle on its middle crouched (nothing shoves the player here any more: the zombie no longer claws him)
  @align s-30 sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 lo=-1081 hi=-1075 timeout=80 settle=10
  @hold f127 duck until sym=WORLD_ARENA offset=4 size=4 op=eq value=8133 timeout=240




map c1a1b
  @checkpoint arrive-c1a1b
  @probe
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=60 value_hi=100
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=between value=-440 value_hi=-330
  @assert sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=between value=-180 value_hi=-80
  # the two carried actors are the last two props (c1a1b cooks 28): slot 28 the Barney (type 1), slot 29 the zombie (type 5), both health 0 as in the reference.
  @assert sym=PROP_KIND offset=28 size=1 op=eq value=1
  @assert sym=PROP_HEALTH offset=28 size=1 op=eq value=0
  @assert sym=PROP_KIND offset=29 size=1 op=eq value=5
  @assert sym=PROP_HEALTH offset=29 size=1 op=eq value=0
  100
  @checkpoint c1a1b-after-100
  @probe
  # no zombie claws: the first hit used to land about 45 polls after the arrival.
  @assert sym=LOGIC_PLAYER_HEALTH size=2 op=between value=76 value_hi=100
  @stop
