  20
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=178 timeout=30
  10
  # closed loop: jump until the feet leave the ground, strafe until the origin has risen 36 over the
  # 49.5 high ledge (about the apex), then duck; no tick count decides the apex
  @hold s127 jump until sym=PLAYER_ON_GROUND size=1 op=eq value=0 timeout=20
  @hold s127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=4 op=ge value=-168 timeout=20
  @hold s127 duck until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=-8 timeout=40
