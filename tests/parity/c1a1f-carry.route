  @hold f-127 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=-850 timeout=60
  # the nudges swing the crowbar: a headcrab (prop 7) hunting the player stands on the east side of the ledge on some builds and body-blocks f38
  # continuous holds, not one-tick align nudges (a one-tick f40 or s40 nudge moves the player by zero or a few units depending on the build's tick phase)
  @hold s-38 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=182 timeout=60
  @hold s38 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=le value=196 timeout=60
  @hold s-38 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=182 timeout=60
  @hold f38 attack until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-888 timeout=60
  20
  @hold f-38 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=le value=-878 timeout=60
  # a headcrab can be standing on the east side by now: sweep the crowbar +-20 degrees with the view tipped down (the crab is below the trace of a level swing; a fixed pattern, harmless when nothing is there), then face east again
  4 l-127
  4 attack t-60
  8 attack t60
  8 attack t-60
  8 attack t60
  4 attack t-60
  @hold l127 until sym=LOGIC_PLAYER_PITCH size=2 signed=true op=ge value=-8 timeout=20
  @hold l-127 until sym=LOGIC_PLAYER_PITCH size=2 signed=true op=le value=8 timeout=20
  @face 1018 right
  10
  @hold f38 attack until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-888 timeout=60
  20
