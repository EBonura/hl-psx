  @hold f127 s-7 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=0 op=ge value=-367 timeout=45
  @hold s-70 until sym=LOGIC_PLAYER_POS size=4 signed=true offset=8 op=ge value=-1100 timeout=40
