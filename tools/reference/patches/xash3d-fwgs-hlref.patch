+			ground = NUM_FOR_EDICT( player->v.groundentity );
+
+		HLRef_Sanitize( train != NULL ? SV_GetString( train->v.targetname ) : "", safe_train_name, sizeof( safe_train_name ));
+		HLRef_Sanitize( train != NULL ? SV_GetString( train->v.target ) : "", safe_train_target, sizeof( safe_train_target ));
+		Q_snprintf( line, sizeof( line ),
+			"HLREF|tick|map=%s|tick=%" PRIu64 "|map_tick=%d|time_ms=%.3f|dt_ms=%.3f"
+			"|player_present=%d|px=%.6f|py=%.6f|pz=%.6f|vx=%.6f|vy=%.6f|vz=%.6f"
+			"|yaw=%.6f|pitch=%.6f|health=%.6f|armor=%.6f|flags=%d|ground=%d"
+			"|train_present=%d|train_edict=%d|train_targetname=%s|train_target=%s"
+			"|train_x=%.6f|train_y=%.6f|train_z=%.6f|train_vx=%.6f|train_vy=%.6f|train_vz=%.6f"
+			"|train_yaw=%.6f|train_speed=%.6f|train_active=%d",
+			sv.name, hlref_tick, sv.framecount + 1, sv.time * 1000.0, sv.frametime * 1000.0,
+			player != NULL ? 1 : 0,
+			player != NULL ? HLRef_CanonicalFloat( player->v.origin[0] ) : 0.0f,
+			player != NULL ? HLRef_CanonicalFloat( player->v.origin[1] ) : 0.0f,
+			player != NULL ? HLRef_CanonicalFloat( player->v.origin[2] ) : 0.0f,
+			player != NULL ? HLRef_CanonicalFloat( player->v.velocity[0] ) : 0.0f,
+			player != NULL ? HLRef_CanonicalFloat( player->v.velocity[1] ) : 0.0f,
+			player != NULL ? HLRef_CanonicalFloat( player->v.velocity[2] ) : 0.0f,
+			player != NULL ? HLRef_CanonicalFloat( player->v.v_angle[1] ) : 0.0f,
+			player != NULL ? HLRef_CanonicalFloat( player->v.v_angle[0] ) : 0.0f,
+			player != NULL ? HLRef_CanonicalFloat( player->v.health ) : 0.0f,
+			player != NULL ? HLRef_CanonicalFloat( player->v.armorvalue ) : 0.0f,
+			player != NULL ? player->v.flags : 0, ground,
+			train != NULL ? 1 : 0, train != NULL ? NUM_FOR_EDICT( train ) : -1, safe_train_name, safe_train_target,
+			train != NULL ? HLRef_CanonicalFloat( train->v.origin[0] ) : 0.0f,
+			train != NULL ? HLRef_CanonicalFloat( train->v.origin[1] ) : 0.0f,
+			train != NULL ? HLRef_CanonicalFloat( train->v.origin[2] ) : 0.0f,
+			train != NULL ? HLRef_CanonicalFloat( train->v.velocity[0] ) : 0.0f,
+			train != NULL ? HLRef_CanonicalFloat( train->v.velocity[1] ) : 0.0f,
+			train != NULL ? HLRef_CanonicalFloat( train->v.velocity[2] ) : 0.0f,
+			train != NULL ? HLRef_CanonicalFloat( train->v.angles[1] ) : 0.0f,
+			train != NULL ? HLRef_CanonicalFloat( train->v.speed ) : 0.0f,
+			train != NULL && train->v.speed != 0.0f ? 1 : 0 );
