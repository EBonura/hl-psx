+	if( hlref_max_ticks != 0 && hlref_tick >= hlref_max_ticks && !hlref_quit_queued )
+	{
+		hlref_quit_queued = true;
+		if( hlref_trace )
+			Con_Printf( "HLREF|stop|map=%s|tick=%" PRIu64 "|reason=max_ticks\n", sv.name, hlref_tick );
+		Cbuf_AddText( "quit\n" );
+	}
+}
