+static qboolean CL_HLRefNeutralInput( void )
+{
+	static int enabled = -1;
+	const char *value;
+
+	if( enabled >= 0 )
+		return enabled != 0;
+
+	value = getenv( "HLREF_NEUTRAL_INPUT" );
+	enabled = !COM_StringEmptyOrNULL( value )
+		&& Q_stricmp( value, "0" )
+		&& Q_stricmp( value, "false" )
+		&& Q_stricmp( value, "off" );
+	return enabled != 0;
+}
+
+#define HLREF_INPUT_ATTACK       (1u << 0)
+#define HLREF_INPUT_JUMP         (1u << 1)
+#define HLREF_INPUT_DUCK         (1u << 2)
+#define HLREF_INPUT_USE          (1u << 3)
+#define HLREF_INPUT_ATTACK2      (1u << 4)
+#define HLREF_INPUT_RELOAD       (1u << 5)
+#define HLREF_INPUT_NEXT_WEAPON  (1u << 6)
+#define HLREF_INPUT_PREV_WEAPON  (1u << 7)
+#define HLREF_INPUT_FLASHLIGHT   (1u << 8)
+#define HLREF_INPUT_KNOWN        ((1u << 9) - 1)
+
+typedef struct
+{
+	uint16_t ticks;
+	int8_t forward, strafe, turn, look;
+	uint16_t actions;
+} hlref_input_run_t;
+
+typedef struct
+{
+	char map[16];
+	char next_map[16];
+	uint32_t total_ticks;
+	uint32_t run_count;
+	uint32_t neutral_tail_ticks;
+	uint32_t flags;
+	hlref_input_run_t *runs;
+} hlref_input_segment_t;
+
+typedef struct
+{
+	qboolean initialized;
+	qboolean enabled;
+	uint16_t segment_count;
+	uint16_t segment_index;
+	uint32_t local_tick;
+	uint32_t run_index;
+	uint16_t run_left;
+	uint16_t previous_actions;
+	hlref_input_segment_t *segments;
+} hlref_input_route_t;
+
+static hlref_input_route_t hlref_input;
+
+static qboolean CL_HLRefRead( FILE *file, void *data, size_t size )
+{
+	return fread( data, 1, size, file ) == size;
+}
+
+static uint16_t CL_HLRefLE16( const byte *data )
+{
+	return (uint16_t)data[0] | ((uint16_t)data[1] << 8);
+}
+
+static uint32_t CL_HLRefLE32( const byte *data )
+{
+	return (uint32_t)data[0] | ((uint32_t)data[1] << 8)
+		| ((uint32_t)data[2] << 16) | ((uint32_t)data[3] << 24);
+}
+
+static qboolean CL_HLRefMapChar( byte value )
+{
+	return (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z')
+		|| (value >= '0' && value <= '9') || value == '_' || value == '-';
+}
+
+static void CL_HLRefDecodeMap( const byte raw[16], char out[16], qboolean allow_empty )
+{
+	int i;
+	qboolean terminated = false;
+
+	for( i = 0; i < 16; ++i )
+	{
+		if( raw[i] == 0 )
+		{
+			terminated = true;
+			out[i] = '\0';
+			break;
+		}
+		if( !CL_HLRefMapChar( raw[i] ))
+			Host_Error( "HLREF semantic input: invalid map-name byte\n" );
+		out[i] = (char)raw[i];
+	}
+	if( !terminated )
+		Host_Error( "HLREF semantic input: unterminated 16-byte map name\n" );
+	for( ; i < 16; ++i )
+	{
+		if( raw[i] != 0 )
+			Host_Error( "HLREF semantic input: nonzero map-name padding\n" );
+	}
+	if( !allow_empty && out[0] == '\0' )
+		Host_Error( "HLREF semantic input: empty map name\n" );
+}
+
+static void CL_HLRefLoadInput( void )
+{
+	const char *path;
+	FILE *file;
+	byte header[16];
+	uint32_t header_flags;
+	uint16_t i;
+
+	if( hlref_input.initialized )
+		return;
+	hlref_input.initialized = true;
+	path = getenv( "HLREF_SEMANTIC_INPUT" );
+	if( COM_StringEmptyOrNULL( path ))
+		return;
+	file = fopen( path, "rb" );
+	if( file == NULL )
+		Host_Error( "HLREF semantic input: cannot open %s\n", path );
+	if( !CL_HLRefRead( file, header, sizeof( header )))
+		Host_Error( "HLREF semantic input: truncated header\n" );
+	if( memcmp( header, "HLINPUT1", 8 ) != 0 )
+		Host_Error( "HLREF semantic input: bad magic\n" );
+	if( CL_HLRefLE16( header + 8 ) != 20 )
+		Host_Error( "HLREF semantic input: tick rate must be 20 Hz\n" );
+	hlref_input.segment_count = CL_HLRefLE16( header + 10 );
+	header_flags = CL_HLRefLE32( header + 12 );
+	if( hlref_input.segment_count == 0 || header_flags != 0 )
+		Host_Error( "HLREF semantic input: invalid segment count or header flags\n" );
+	hlref_input.segments = calloc( hlref_input.segment_count, sizeof( *hlref_input.segments ));
+	if( hlref_input.segments == NULL )
+		Host_Error( "HLREF semantic input: out of memory for segments\n" );
+
+	for( i = 0; i < hlref_input.segment_count; ++i )
+	{
+		byte raw[48];
+		hlref_input_segment_t *segment = &hlref_input.segments[i];
+		uint64_t expanded = 0;
+		uint32_t run;
+
+		if( !CL_HLRefRead( file, raw, sizeof( raw )))
+			Host_Error( "HLREF semantic input: truncated segment %u\n", i );
+		CL_HLRefDecodeMap( raw, segment->map, false );
+		CL_HLRefDecodeMap( raw + 16, segment->next_map, true );
+		segment->total_ticks = CL_HLRefLE32( raw + 32 );
+		segment->run_count = CL_HLRefLE32( raw + 36 );
+		segment->neutral_tail_ticks = CL_HLRefLE32( raw + 40 );
+		segment->flags = CL_HLRefLE32( raw + 44 );
+		if( segment->run_count == 0 || segment->flags != 0 )
+			Host_Error( "HLREF semantic input: invalid runs or flags in map %s\n", segment->map );
+		segment->runs = calloc( segment->run_count, sizeof( *segment->runs ));
+		if( segment->runs == NULL )
+			Host_Error( "HLREF semantic input: out of memory for map %s\n", segment->map );
+		for( run = 0; run < segment->run_count; ++run )
+		{
+			byte packed[8];
+			hlref_input_run_t *decoded = &segment->runs[run];
+			if( !CL_HLRefRead( file, packed, sizeof( packed )))
+				Host_Error( "HLREF semantic input: truncated run in map %s\n", segment->map );
+			decoded->ticks = CL_HLRefLE16( packed );
+			decoded->forward = (int8_t)packed[2];
+			decoded->strafe = (int8_t)packed[3];
+			decoded->turn = (int8_t)packed[4];
+			decoded->look = (int8_t)packed[5];
+			decoded->actions = CL_HLRefLE16( packed + 6 );
+			if( decoded->ticks == 0 || (decoded->actions & ~HLREF_INPUT_KNOWN) != 0 )
+				Host_Error( "HLREF semantic input: invalid run in map %s\n", segment->map );
+			expanded += decoded->ticks;
+		}
+		if( expanded != segment->total_ticks )
+			Host_Error( "HLREF semantic input: tick total mismatch in map %s\n", segment->map );
+	}
+	if( fgetc( file ) != EOF )
+		Host_Error( "HLREF semantic input: trailing bytes\n" );
+	fclose( file );
+	for( i = 0; i < hlref_input.segment_count; ++i )
+	{
+		const char *expected = i + 1 < hlref_input.segment_count
+			? hlref_input.segments[i + 1].map : "";
+		if( Q_strcmp( hlref_input.segments[i].next_map, expected ))
+			Host_Error( "HLREF semantic input: next-map mismatch after %s\n", hlref_input.segments[i].map );
+	}
+	hlref_input.segment_index = UINT16_MAX;
+	hlref_input.enabled = true;
+}
+
+static void CL_HLRefBeginInputMap( void )
+{
+	uint16_t next = hlref_input.segment_index == UINT16_MAX
+		? 0 : (uint16_t)(hlref_input.segment_index + 1);
+	if( next >= hlref_input.segment_count )
+		Host_Error( "HLREF semantic input: unexpected map %s after final segment\n", clgame.mapname );
+	if( Q_strcmp( hlref_input.segments[next].map, clgame.mapname ))
+		Host_Error( "HLREF semantic input: got map %s, expected %s\n",
+			clgame.mapname, hlref_input.segments[next].map );
+	hlref_input.segment_index = next;
+	hlref_input.local_tick = 0;
+	hlref_input.run_index = 0;
+	hlref_input.run_left = hlref_input.segments[next].runs[0].ticks;
+	hlref_input.previous_actions = 0;
+	Con_Printf( "HLREF|input_map|map=%s|input_tick=0|segment=%u\n", clgame.mapname, next );
+}
+
+static qboolean CL_HLRefSemanticInput( usercmd_t *cmd, vec3_t angles, qboolean active )
+{
+	hlref_input_segment_t *segment;
+	hlref_input_run_t neutral = { 1, 0, 0, 0, 0, 0 };
+	hlref_input_run_t *run;
+	uint16_t actions, pressed;
+	float maxspeed, yaw_delta, pitch_delta;
+
+	CL_HLRefLoadInput();
+	if( !hlref_input.enabled )
+		return false;
+	if( !active )
+	{
+		cmd->forwardmove = cmd->sidemove = cmd->upmove = 0.0f;
+		cmd->buttons = 0;
+		cmd->impulse = cmd->weaponselect = 0;
+		VectorCopy( angles, cmd->viewangles );
+		VectorCopy( angles, cl.viewangles );
+		return true; // suppress host input without consuming a physics sample
+	}
+	if( hlref_input.segment_index == UINT16_MAX
+		|| Q_strcmp( hlref_input.segments[hlref_input.segment_index].map, clgame.mapname ))
+		CL_HLRefBeginInputMap();
+	segment = &hlref_input.segments[hlref_input.segment_index];
+	if( hlref_input.local_tick < segment->total_ticks )
+	{
+		run = &segment->runs[hlref_input.run_index];
+		if( --hlref_input.run_left == 0 )
+		{
+			hlref_input.run_index++;
+			if( hlref_input.run_index < segment->run_count )
+				hlref_input.run_left = segment->runs[hlref_input.run_index].ticks;
+		}
+	}
+	else
+	{
+		uint64_t end = (uint64_t)segment->total_ticks + segment->neutral_tail_ticks;
+		if( hlref_input.local_tick >= end )
+			Host_Error( "HLREF semantic input: map %s exhausted at input tick %u\n",
+				segment->map, hlref_input.local_tick );
+		run = &neutral;
+	}
+
+	maxspeed = cl.local.maxspeed > 0.0f ? cl.local.maxspeed : 320.0f;
+	cmd->forwardmove = run->forward * maxspeed / 128.0f;
+	cmd->sidemove = run->strafe * maxspeed / 128.0f;
+	cmd->upmove = 0.0f;
+	actions = run->actions;
+	cmd->buttons = 0;
+	if( actions & HLREF_INPUT_ATTACK ) cmd->buttons |= IN_ATTACK;
+	if( actions & HLREF_INPUT_JUMP ) cmd->buttons |= IN_JUMP;
+	if( actions & HLREF_INPUT_DUCK ) cmd->buttons |= IN_DUCK;
+	if( actions & HLREF_INPUT_USE ) cmd->buttons |= IN_USE;
+	if( actions & HLREF_INPUT_ATTACK2 ) cmd->buttons |= IN_ATTACK2;
+	if( actions & HLREF_INPUT_RELOAD ) cmd->buttons |= IN_RELOAD;
+	if( run->forward > 0 ) cmd->buttons |= IN_FORWARD;
+	if( run->forward < 0 ) cmd->buttons |= IN_BACK;
+	if( run->strafe > 0 ) cmd->buttons |= IN_MOVERIGHT;
+	if( run->strafe < 0 ) cmd->buttons |= IN_MOVELEFT;
+	pressed = actions & ~hlref_input.previous_actions;
+	cmd->impulse = (pressed & HLREF_INPUT_FLASHLIGHT) ? 100 : 0;
+	cmd->weaponselect = 0;
+	if( pressed & HLREF_INPUT_NEXT_WEAPON ) Cbuf_AddText( "invnext\n" );
+	if( pressed & HLREF_INPUT_PREV_WEAPON ) Cbuf_AddText( "invprev\n" );
+	hlref_input.previous_actions = actions;
+
+	yaw_delta = ((float)run->turn * 130.0f / 128.0f) * (360.0f / 4096.0f);
+	pitch_delta = ((float)run->look * 95.0f / 128.0f) * (360.0f / 4096.0f);
+	angles[YAW] -= yaw_delta;
+	angles[PITCH] = bound( -89.0f, angles[PITCH] - pitch_delta, 89.0f );
+	VectorCopy( angles, cmd->viewangles );
+	VectorCopy( angles, cl.viewangles );
+	Con_Printf( "HLREF|input|map=%s|tick=%u|input_tick=%u|forward=%d|strafe=%d|turn=%d|look=%d|actions=0x%04x\n",
+		segment->map, hlref_input.local_tick, hlref_input.local_tick, run->forward, run->strafe,
+		run->turn, run->look, actions );
+	hlref_input.local_tick++;
+	return true;
+}
+
