+/*
+===============================================================================
+
+Deterministic Half-Life reference capture
+
+This is deliberately environment-only and inert in normal engine runs:
+  HLREF_TRACE=1          emit stable pipe-delimited post-physics state
+  HLREF_SEED=<nonzero>   reset the game RNG immediately before map entities spawn
+  HLREF_MAX_TICKS=<n>    queue `quit` after n server physics frames
+
+The capture clock is supplied by the regular `host_framerate 0.05` cvar so the
+reference follows the same 20 Hz target as hl-psx without changing engine timing
+for anyone who did not opt in.
+
+===============================================================================
+*/
+
+static qboolean hlref_initialized;
+static qboolean hlref_trace;
+static qboolean hlref_seed_set;
+static qboolean hlref_quit_queued;
+static int hlref_seed;
+static uint64_t hlref_tick;
+static uint64_t hlref_max_ticks;
+
+static qboolean HLRef_EnvEnabled( const char *name )
+{
+	const char *value = getenv( name );
+
+	if( COM_StringEmptyOrNULL( value ))
+		return false;
+	if( !Q_stricmp( value, "0" ) || !Q_stricmp( value, "false" ) || !Q_stricmp( value, "off" ))
+		return false;
+	return true;
+}
+
+static void HLRef_Sanitize( const char *input, char *output, size_t output_size )
+{
+	size_t i = 0;
+
+	if( output_size == 0 )
+		return;
+	if( input == NULL )
+		input = "";
+
+	while( *input != '\0' && i + 1 < output_size )
+	{
+		unsigned char c = (unsigned char)*input++;
+
+		if( c == '|' || c == '\n' || c == '\r' || c < 0x20 )
+			c = '_';
+		output[i++] = (char)c;
+	}
+	output[i] = '\0';
+}
+
+static void HLRef_Init( void )
+{
+	const char *value;
+	char *end;
+	long parsed_seed;
+	unsigned long long parsed_ticks;
+
+	if( hlref_initialized )
+		return;
+	hlref_initialized = true;
+	hlref_trace = HLRef_EnvEnabled( "HLREF_TRACE" );
+
+	value = getenv( "HLREF_SEED" );
+	if( !COM_StringEmptyOrNULL( value ))
+	{
+		end = NULL;
+		parsed_seed = strtol( value, &end, 10 );
+		if( end != value && *end == '\0' && parsed_seed >= INT_MIN && parsed_seed <= INT_MAX && parsed_seed != 0 )
+		{
+			hlref_seed = (int)parsed_seed;
+			hlref_seed_set = true;
+		}
+		else
+		{
+			Con_Printf( S_WARN "HLREF_SEED must be a nonzero 32-bit integer; deterministic seeding disabled\n" );
+		}
+	}
+
+	value = getenv( "HLREF_MAX_TICKS" );
+	if( !COM_StringEmptyOrNULL( value ))
+	{
+		end = NULL;
+		parsed_ticks = strtoull( value, &end, 10 );
+		if( end != value && *end == '\0' )
+			hlref_max_ticks = (uint64_t)parsed_ticks;
+		else Con_Printf( S_WARN "HLREF_MAX_TICKS must be an unsigned integer; automatic stop disabled\n" );
+	}
+}
+
+void HLRef_SeedMap( const char *mapname )
+{
+	char safe_map[MAX_QPATH];
+
+	HLRef_Init();
+	if( hlref_seed_set )
+		COM_SetRandomSeed( hlref_seed );
+
+	if( hlref_trace )
+	{
+		HLRef_Sanitize( mapname, safe_map, sizeof( safe_map ));
+		Con_Printf( "HLREF|map|map=%s|seed_set=%d|seed=%d\n",
+			safe_map, hlref_seed_set ? 1 : 0, hlref_seed_set ? hlref_seed : 0 );
+	}
+}
+
+static edict_t *HLRef_FindPlayer( void )
+{
+	int last = Q_min( svs.maxclients, svgame.numEntities - 1 );
+
+	for( int i = 1; i <= last; i++ )
+	{
+		edict_t *ent = SV_EdictNum( i );
+
+		if( ent != NULL && !ent->free && !Q_stricmp( SV_ClassName( ent ), "player" ))
+			return ent;
+	}
+	return NULL;
+}
+
+static edict_t *HLRef_FindTrackTrain( void )
+{
+	edict_t *first = NULL;
+
+	for( int i = 1; i < svgame.numEntities; i++ )
+	{
+		edict_t *ent = SV_EdictNum( i );
+		const char *targetname;
+
+		if( ent == NULL || ent->free || Q_stricmp( SV_ClassName( ent ), "func_tracktrain" ))
+			continue;
+		if( first == NULL )
+			first = ent;
+
+		targetname = SV_GetString( ent->v.targetname );
+		if( targetname != NULL && !Q_stricmp( targetname, "train" ))
+			return ent;
+	}
+	return first;
+}
+
+static float HLRef_CanonicalFloat( float value )
+{
+	return fabsf( value ) < 0.0000005f ? 0.0f : value;
+}
+
+static void HLRef_EmitTrackTrains( void )
+{
+	char line[1024];
+	char safe_name[128];
+	char safe_target[128];
+
+	for( int i = 1; i < svgame.numEntities; i++ )
+	{
+		edict_t *ent = SV_EdictNum( i );
+
+		if( ent == NULL || ent->free || Q_stricmp( SV_ClassName( ent ), "func_tracktrain" ))
+			continue;
+
+		HLRef_Sanitize( SV_GetString( ent->v.targetname ), safe_name, sizeof( safe_name ));
+		HLRef_Sanitize( SV_GetString( ent->v.target ), safe_target, sizeof( safe_target ));
+		Q_snprintf( line, sizeof( line ),
+			"HLREF|tracktrain|map=%s|tick=%" PRIu64 "|map_tick=%d|edict=%d|targetname=%s|target=%s"
+			"|x=%.6f|y=%.6f|z=%.6f|vx=%.6f|vy=%.6f|vz=%.6f"
+			"|pitch=%.6f|yaw=%.6f|roll=%.6f|speed=%.6f|active=%d|nextthink=%.6f|ltime=%.6f",
+			sv.name, hlref_tick, sv.framecount + 1, i, safe_name, safe_target,
+			HLRef_CanonicalFloat( ent->v.origin[0] ), HLRef_CanonicalFloat( ent->v.origin[1] ), HLRef_CanonicalFloat( ent->v.origin[2] ),
+			HLRef_CanonicalFloat( ent->v.velocity[0] ), HLRef_CanonicalFloat( ent->v.velocity[1] ), HLRef_CanonicalFloat( ent->v.velocity[2] ),
+			HLRef_CanonicalFloat( ent->v.angles[0] ), HLRef_CanonicalFloat( ent->v.angles[1] ), HLRef_CanonicalFloat( ent->v.angles[2] ),
