+/*
+ * Direct-loading an intermediate Half-Life BSP is not generally a valid
+ * gameplay state: many maps have no player start, and a few starts live in
+ * sealed transition pockets.  The deterministic harness may therefore supply
+ * an explicit checkpoint origin/view.  Apply it once, immediately before the
+ * first player physics frame, so the captured route starts from a declared
+ * state instead of relying on a map's chapter-select accident.
+ */
+static bool HLRefParseVec3Env( const char *name, Vector &value )
+{
+	const char *text = getenv( name );
+	float x, y, z;
+	char trailing;
+
+	if( text == NULL || text[0] == '\0' )
+		return false;
+	if( sscanf( text, " %f %f %f %c", &x, &y, &z, &trailing ) != 3 )
+	{
+		ALERT( at_warning, "%s must contain exactly three finite numbers\n", name );
+		return false;
+	}
+	if( x != x || y != y || z != z || fabs( x ) > 1000000.0f
+		|| fabs( y ) > 1000000.0f || fabs( z ) > 1000000.0f )
+	{
+		ALERT( at_warning, "%s contains an invalid number\n", name );
+		return false;
+	}
+	value = Vector( x, y, z );
+	return true;
+}
+
+static void HLRefApplyInitialState( CBasePlayer *player )
+{
+	static bool applied = false;
+	Vector origin;
+	Vector angles;
+	bool haveOrigin;
+	bool haveAngles;
+	char line[512];
+
+	if( applied )
+		return;
+	haveOrigin = HLRefParseVec3Env( "HLREF_INITIAL_ORIGIN", origin );
+	haveAngles = HLRefParseVec3Env( "HLREF_INITIAL_ANGLES", angles );
+	if( !haveOrigin && !haveAngles )
+		return;
+	applied = true;
+
+	if( haveOrigin )
+	{
+		player->pev->velocity = g_vecZero;
+		player->pev->basevelocity = g_vecZero;
+		UTIL_SetOrigin( player->pev, origin );
+	}
+	if( haveAngles )
+	{
+		player->pev->angles = angles;
+		player->pev->v_angle = angles;
+		player->pev->punchangle = g_vecZero;
+		player->pev->fixangle = TRUE;
+	}
+
+	safe_snprintf( line, sizeof( line ),
+		"HLREF|event|map=%s|tick=%lu|event=initial_state|origin_set=%d|angles_set=%d"
+		"|x=%.6f|y=%.6f|z=%.6f|pitch=%.6f|yaw=%.6f|roll=%.6f\n",
+		STRING( gpGlobals->mapname ), (unsigned long)g_ulFrameCount,
+		haveOrigin ? 1 : 0, haveAngles ? 1 : 0,
+		player->pev->origin.x, player->pev->origin.y, player->pev->origin.z,
+		player->pev->v_angle.x, player->pev->v_angle.y, player->pev->v_angle.z );
+	g_engfuncs.pfnServerPrint( line );
+}
+
+/*
+ * Once-per-second post-physics entity checkpoints. Target dispatch tells us
+ * that a script ran; these rows reveal whether the physical result (cart,
+ * lift, door, scientist, breakable) actually matches the original engine.
+ */
+static bool HLRefEntityTraceEnabled( void )
+{
+	static int enabled = -1;
+	const char *value;
+
+	if( enabled >= 0 )
+		return enabled != 0;
+	value = getenv( "HLREF_TRACE" );
+	enabled = value != NULL && value[0] != '\0'
+		&& strcmp( value, "0" )
+		&& strcmp( value, "false" )
+		&& strcmp( value, "off" );
+	return enabled != 0;
+}
+
+static unsigned long HLRefEntityTraceInterval( void )
+{
+	static unsigned long interval = 0;
+	const char *value;
+	char *end = NULL;
+	unsigned long parsed;
+
+	if( interval != 0 )
+		return interval;
+	value = getenv( "HLREF_ENTITY_INTERVAL" );
+	parsed = value != NULL && value[0] != '\0' ? strtoul( value, &end, 10 ) : 20;
+	if( parsed < 1 || parsed > 1000 ||
+		( value != NULL && value[0] != '\0' && *end != '\0' ))
+		parsed = 20;
+	interval = parsed;
+	return interval;
+}
+
+static bool HLRefCheckpointClass( const char *name )
+{
+	return !strcmp( name, "func_door" )
+		|| !strcmp( name, "func_door_rotating" )
+		|| !strcmp( name, "func_train" )
+		|| !strcmp( name, "func_tracktrain" )
+		|| !strcmp( name, "func_pushable" )
+		|| !strcmp( name, "func_plat" )
+		|| !strcmp( name, "func_platrot" )
+		|| !strcmp( name, "func_breakable" )
+		|| !strcmp( name, "func_wall" )
+		|| !strcmp( name, "func_wall_toggle" )
+		|| !strcmp( name, "func_rotating" )
+		|| !strcmp( name, "monster_generic" )
+		|| !strcmp( name, "monster_scientist" )
+		|| !strcmp( name, "monster_barney" );
+}
+
+static void HLRefCheckpointEntities( void )
+{
+	static char lastMap[128] = "";
+	static unsigned long mapTick = 0;
+	static float lastTime = -1.0f;
+	edict_t *edict;
+	char line[1536];
+	char map[128];
+	char classname[128];
+	char targetname[128];
+	char globalname[128];
+	char model[128];
+	int brush;
+	int i;
+
+	if( !HLRefEntityTraceEnabled() )
+		return;
+	safe_snprintf( map, sizeof( map ), "%s", STRING( gpGlobals->mapname ));
+	if( strcmp( lastMap, map ) || gpGlobals->time < lastTime )
+	{
+		safe_snprintf( lastMap, sizeof( lastMap ), "%s", map );
+		mapTick = 0;
+	}
+	else
+	{
+		++mapTick;
+	}
+	lastTime = gpGlobals->time;
+	if( mapTick % HLRefEntityTraceInterval() != 0 )
+		return;
+	edict = g_engfuncs.pfnPEntityOfEntIndex( 1 );
+	if( edict == NULL )
+		return;
+
+	for( i = 1; i < gpGlobals->maxEntities; ++i, ++edict )
+	{
+		const char *rawClass;
+
+		if( edict->free )
+			continue;
+		rawClass = STRING( edict->v.classname );
+		if( rawClass == NULL || !HLRefCheckpointClass( rawClass ))
+			continue;
+
+		safe_snprintf( classname, sizeof( classname ), "%s", rawClass );
+		safe_snprintf( targetname, sizeof( targetname ), "%s", STRING( edict->v.targetname ));
+		safe_snprintf( globalname, sizeof( globalname ), "%s", STRING( edict->v.globalname ));
+		safe_snprintf( model, sizeof( model ), "%s", STRING( edict->v.model ));
+		brush = model[0] == '*' ? atoi( model + 1 ) : -1;
+		safe_snprintf( line, sizeof( line ),
+			"HLREF|entity|map=%s|tick=%lu|map_tick=%lu|edict=%d|class=%s|targetname=%s|globalname=%s|model=%s|brush=%d"
+			"|x=%.6f|y=%.6f|z=%.6f|vx=%.6f|vy=%.6f|vz=%.6f"
+			"|avx=%.6f|avy=%.6f|avz=%.6f|ltime=%.6f|nextthink=%.6f"
+			"|cx=%.6f|cy=%.6f|cz=%.6f"
+			"|pitch=%.6f|yaw=%.6f|roll=%.6f|sequence=%d|frame=%.6f|health=%.6f"
+			"|solid=%d|movetype=%d|flags=%d|spawnflags=%d\n",
+			map, (unsigned long)g_ulFrameCount, mapTick, i, classname, targetname, globalname, model, brush,
+			edict->v.origin.x, edict->v.origin.y, edict->v.origin.z,
+			edict->v.velocity.x, edict->v.velocity.y, edict->v.velocity.z,
+			edict->v.avelocity.x, edict->v.avelocity.y, edict->v.avelocity.z,
+			edict->v.ltime, edict->v.nextthink,
+			(edict->v.absmin.x + edict->v.absmax.x) * 0.5,
+			(edict->v.absmin.y + edict->v.absmax.y) * 0.5,
+			(edict->v.absmin.z + edict->v.absmax.z) * 0.5,
+			edict->v.angles.x, edict->v.angles.y, edict->v.angles.z,
+			edict->v.sequence, edict->v.frame, edict->v.health,
+			edict->v.solid, edict->v.movetype, edict->v.flags, edict->v.spawnflags );
+		g_engfuncs.pfnServerPrint( line );
+	}
+}
