 extern DLL_GLOBAL int g_iSkillLevel;
+extern DLL_GLOBAL ULONG g_ulFrameCount;
+
+/*
+ * Target dispatch is the semantic backbone of scripted Half-Life maps.  Keep
+ * this reference trace completely opt-in so an unmodified environment retains
+ * the stock SDK behavior and output.
+ */
+static bool HLRefTraceEnabled( void )
+{
+	static int enabled = -1;
+	const char *value;
+
+	if( enabled >= 0 )
+		return enabled != 0;
+
+	value = getenv( "HLREF_TRACE" );
+	enabled = value != NULL && value[0] != '\0'
+		&& strcmp( value, "0" )
+		&& strcmp( value, "false" )
+		&& strcmp( value, "off" );
+	return enabled != 0;
+}
+
+static void HLRefSanitize( const char *input, char *output, size_t outputSize )
+{
+	size_t i = 0;
+
+	if( outputSize == 0 )
+		return;
+	if( input == NULL )
+		input = "";
+
+	while( *input != '\0' && i + 1 < outputSize )
+	{
+		unsigned char c = (unsigned char)*input++;
+
+		if( c == '|' || c == '\n' || c == '\r' || c < 0x20 )
+			c = '_';
+		output[i++] = (char)c;
+	}
+	output[i] = '\0';
+}
+
+static void HLRefTraceTargetFire( const char *targetName, CBaseEntity *pActivator,
+	CBaseEntity *pCaller, USE_TYPE useType, float value )
+{
+	char line[1536];
+	char map[128];
+	char target[256];
+	char activatorClass[128];
+	char activatorName[128];
+	char callerClass[128];
+	char callerName[128];
+	int activatorEdict = -1;
+	int callerEdict = -1;
+
+	if( !HLRefTraceEnabled() )
+		return;
+
+	HLRefSanitize( STRING( gpGlobals->mapname ), map, sizeof( map ));
+	HLRefSanitize( targetName, target, sizeof( target ));
+	HLRefSanitize( pActivator != NULL ? STRING( pActivator->pev->classname ) : "", activatorClass, sizeof( activatorClass ));
+	HLRefSanitize( pActivator != NULL ? STRING( pActivator->pev->targetname ) : "", activatorName, sizeof( activatorName ));
+	HLRefSanitize( pCaller != NULL ? STRING( pCaller->pev->classname ) : "", callerClass, sizeof( callerClass ));
+	HLRefSanitize( pCaller != NULL ? STRING( pCaller->pev->targetname ) : "", callerName, sizeof( callerName ));
+	if( pActivator != NULL )
+		activatorEdict = ENTINDEX( ENT( pActivator->pev ));
+	if( pCaller != NULL )
+		callerEdict = ENTINDEX( ENT( pCaller->pev ));
+
+	safe_snprintf( line, sizeof( line ),
+		"HLREF|event|map=%s|tick=%lu|time_ms=%.3f|event=target_fire|target=%s|use=%d|value=%.6f"
+		"|activator_edict=%d|activator_class=%s|activator_name=%s"
+		"|caller_edict=%d|caller_class=%s|caller_name=%s\n",
+		map, (unsigned long)g_ulFrameCount, gpGlobals->time * 1000.0,
+		target, (int)useType, value,
+		activatorEdict, activatorClass, activatorName,
+		callerEdict, callerClass, callerName );
+	g_engfuncs.pfnServerPrint( line );
+}
 
