# monster_human_grunt (HECU): the schedules, how a squad member picks one, and its attack parameters.
# Grunt flag A = carries a grenade launcher. Attack ranges are map units; cone is the dot product with the enemy.

species grunt id=8 parent=squad flags=A r1=0..2048 cone=0.5 r2=256..1024 melee=80

sched "Grunt Fail" species=grunt interrupt=CAN_RANGE_ATTACK1|CAN_RANGE_ATTACK2|CAN_MELEE_ATTACK1|CAN_MELEE_ATTACK2
  STOP_MOVING
  SET_ACTIVITY IDLE
  WAIT 2
  WAIT_PVS
end

sched "Grunt Combat Fail" species=grunt interrupt=CAN_RANGE_ATTACK1|CAN_RANGE_ATTACK2
  STOP_MOVING
  SET_ACTIVITY IDLE
  WAIT_FACE_ENEMY 2
  WAIT_PVS
end

sched "GruntVictoryDance" species=grunt interrupt=NEW_ENEMY|LIGHT_DAMAGE|HEAVY_DAMAGE
  STOP_MOVING
  FACE_ENEMY
  WAIT 1.5
  GET_PATH_TO_ENEMY_CORPSE
  WALK_PATH
  WAIT_FOR_MOVEMENT
  FACE_ENEMY
  PLAY_SEQUENCE VICTORY_DANCE
end

sched "GruntEstablishLineOfFire" species=grunt interrupt=NEW_ENEMY|ENEMY_DEAD|CAN_RANGE_ATTACK1|CAN_MELEE_ATTACK1|CAN_RANGE_ATTACK2|CAN_MELEE_ATTACK2|HEAR_SOUND sound=DANGER
  SET_FAIL_SCHEDULE GRUNT_ELOF_FAIL
  GET_PATH_TO_ENEMY
  CUSTOM GRUNT_SPEAK
  RUN_PATH
  WAIT_FOR_MOVEMENT
end

sched "GruntFoundEnemy" species=grunt interrupt=HEAR_SOUND sound=DANGER
  STOP_MOVING
  FACE_ENEMY
  PLAY_SEQUENCE_FACE_ENEMY SIGNAL1
end

sched "Combat Face" species=grunt interrupt=NEW_ENEMY|ENEMY_DEAD|CAN_RANGE_ATTACK1|CAN_RANGE_ATTACK2
  STOP_MOVING
  SET_ACTIVITY IDLE
  FACE_ENEMY
  WAIT 1.5
  SET_SCHEDULE GRUNT_SWEEP
end

sched "SignalSuppress" species=grunt interrupt=ENEMY_DEAD|LIGHT_DAMAGE|HEAVY_DAMAGE|HEAR_SOUND|SPECIAL1|NO_AMMO_LOADED sound=DANGER
  STOP_MOVING
  FACE_IDEAL
  PLAY_SEQUENCE_FACE_ENEMY SIGNAL2
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
end

sched "Suppress" species=grunt interrupt=ENEMY_DEAD|LIGHT_DAMAGE|HEAVY_DAMAGE|HEAR_SOUND|SPECIAL1|NO_AMMO_LOADED sound=DANGER
  STOP_MOVING
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
end

sched "GruntWaitInCover" species=grunt interrupt=NEW_ENEMY|HEAR_SOUND|CAN_RANGE_ATTACK1|CAN_RANGE_ATTACK2|CAN_MELEE_ATTACK1|CAN_MELEE_ATTACK2 sound=DANGER
  STOP_MOVING
  SET_ACTIVITY IDLE
  WAIT_FACE_ENEMY 1
end

sched "TakeCover" species=grunt
  STOP_MOVING
  SET_FAIL_SCHEDULE GRUNT_TAKECOVER_FAILED
  WAIT 0.2
  FIND_COVER_FROM_ENEMY
  CUSTOM GRUNT_SPEAK
  RUN_PATH
  WAIT_FOR_MOVEMENT
  REMEMBER IN_COVER
  SET_SCHEDULE GRUNT_WAIT_FACE_ENEMY
end

sched "GrenadeCover" species=grunt
  STOP_MOVING
  FIND_COVER_FROM_ENEMY 99
  FIND_FAR_NODE_COVER_FROM_ENEMY 384
  PLAY_SEQUENCE SPECIAL_ATTACK1
  CLEAR_MOVE_WAIT
  RUN_PATH
  WAIT_FOR_MOVEMENT
  SET_SCHEDULE GRUNT_WAIT_FACE_ENEMY
end

sched "TossGrenadeCover" species=grunt
  FACE_ENEMY
  RANGE_ATTACK2
  SET_SCHEDULE TAKE_COVER_FROM_ENEMY
end

sched "GruntTakeCoverFromBestSound" species=grunt
  SET_FAIL_SCHEDULE COWER
  STOP_MOVING
  FIND_COVER_FROM_BEST_SOUND
  RUN_PATH
  WAIT_FOR_MOVEMENT
  REMEMBER IN_COVER
  TURN_LEFT 179
end

sched "GruntHideReload" species=grunt interrupt=HEAVY_DAMAGE|HEAR_SOUND sound=DANGER
  STOP_MOVING
  SET_FAIL_SCHEDULE RELOAD
  FIND_COVER_FROM_ENEMY
  RUN_PATH
  WAIT_FOR_MOVEMENT
  REMEMBER IN_COVER
  FACE_ENEMY
  PLAY_SEQUENCE RELOAD
end

sched "Grunt Sweep" species=grunt interrupt=NEW_ENEMY|LIGHT_DAMAGE|HEAVY_DAMAGE|CAN_RANGE_ATTACK1|CAN_RANGE_ATTACK2|HEAR_SOUND sound=WORLD|DANGER|PLAYER
  TURN_LEFT 179
  WAIT 1
  TURN_LEFT 179
  WAIT 1
end

sched "Range Attack1A" species=grunt interrupt=NEW_ENEMY|ENEMY_DEAD|HEAVY_DAMAGE|ENEMY_OCCLUDED|HEAR_SOUND|SPECIAL1|NO_AMMO_LOADED sound=DANGER
  STOP_MOVING
  PLAY_SEQUENCE_FACE_ENEMY CROUCH
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
end

sched "Range Attack1B" species=grunt interrupt=NEW_ENEMY|ENEMY_DEAD|HEAVY_DAMAGE|ENEMY_OCCLUDED|NO_AMMO_LOADED|SPECIAL1|HEAR_SOUND sound=DANGER
  STOP_MOVING
  PLAY_SEQUENCE_FACE_ENEMY IDLE_ANGRY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
  FACE_ENEMY
  CUSTOM GRUNT_CHECK_FIRE
  RANGE_ATTACK1
end

sched "RangeAttack2" species=grunt
  STOP_MOVING
  CUSTOM GRUNT_FACE_TOSS_DIR
  PLAY_SEQUENCE RANGE_ATTACK2
  SET_SCHEDULE GRUNT_WAIT_FACE_ENEMY
end

type grunt TAKE_COVER_FROM_ENEMY when HARD_GRENADE_COVER -> "TossGrenadeCover"
type grunt TAKE_COVER_FROM_ENEMY when IN_SQUAD -> "TakeCover"
type grunt TAKE_COVER_FROM_ENEMY when RANDOM_HALF -> "TakeCover"
type grunt TAKE_COVER_FROM_ENEMY -> "GrenadeCover"
type grunt TAKE_COVER_FROM_BEST_SOUND -> "GruntTakeCoverFromBestSound"
type grunt GRUNT_TAKECOVER_FAILED when CAN_RANGE1_ENGAGE -> @RANGE_ATTACK1
type grunt GRUNT_TAKECOVER_FAILED -> @FAIL
type grunt GRUNT_ELOF_FAIL -> @TAKE_COVER_FROM_ENEMY
type grunt GRUNT_ESTABLISH_LINE_OF_FIRE -> "GruntEstablishLineOfFire"
type grunt RANGE_ATTACK1 when ROLL_STANDING -> "Range Attack1B"
type grunt RANGE_ATTACK1 -> "Range Attack1A"
type grunt RANGE_ATTACK2 -> "RangeAttack2"
type grunt COMBAT_FACE -> "Combat Face"
type grunt GRUNT_WAIT_FACE_ENEMY -> "GruntWaitInCover"
type grunt GRUNT_SWEEP -> "Grunt Sweep"
type grunt GRUNT_COVER_AND_RELOAD -> "GruntHideReload"
type grunt GRUNT_FOUND_ENEMY -> "GruntFoundEnemy"
type grunt VICTORY_DANCE when NOT_LEADER -> "Grunt Fail"
type grunt VICTORY_DANCE -> "GruntVictoryDance"
type grunt GRUNT_SUPPRESS when FIRST_ENCOUNTER_TAKE -> "SignalSuppress"
type grunt GRUNT_SUPPRESS -> "Suppress"
type grunt FAIL when HAS_ENEMY -> "Grunt Combat Fail"
type grunt FAIL -> "Grunt Fail"

# CHGrunt::GetSchedule, in order. A danger sound sends the grunt for cover from it in any state.
pick grunt states=IDLE|ALERT|COMBAT|HUNT any=HEAR_SOUND when DANGER_SOUND -> TAKE_COVER_FROM_BEST_SOUND
# New enemy in a squad: members take cover, the leader suppresses or establishes a line of fire.
pick grunt states=COMBAT any=NEW_ENEMY none=ENEMY_DEAD when IN_SQUAD,NOT_LEADER fx=CLEAR_ELUDED -> TAKE_COVER_FROM_ENEMY
pick grunt states=COMBAT all=NEW_ENEMY|CAN_RANGE_ATTACK1 none=ENEMY_DEAD when IS_LEADER fx=CLEAR_ELUDED -> GRUNT_SUPPRESS
pick grunt states=COMBAT any=NEW_ENEMY none=ENEMY_DEAD when IS_LEADER fx=CLEAR_ELUDED -> GRUNT_ESTABLISH_LINE_OF_FIRE
# The else-if chain (a lone grunt with a new enemy skips it).
pick grunt states=COMBAT any=NO_AMMO_LOADED none=ENEMY_DEAD|NEW_ENEMY -> GRUNT_COVER_AND_RELOAD
pick grunt states=COMBAT any=LIGHT_DAMAGE none=ENEMY_DEAD|NEW_ENEMY when LIGHT_DAMAGE_90 -> TAKE_COVER_FROM_ENEMY
pick grunt states=COMBAT any=LIGHT_DAMAGE none=ENEMY_DEAD|NEW_ENEMY -> SMALL_FLINCH
pick grunt states=COMBAT any=CAN_MELEE_ATTACK1 none=ENEMY_DEAD|NEW_ENEMY -> MELEE_ATTACK1
pick grunt states=COMBAT any=CAN_RANGE_ATTACK2 none=ENEMY_DEAD|NEW_ENEMY when FLAG_A,OCCUPY_GRENADE -> RANGE_ATTACK2
pick grunt states=COMBAT any=CAN_RANGE_ATTACK1 none=ENEMY_DEAD|NEW_ENEMY|ENEMY_FACING_ME when SQUAD_ENEMY_ELUDED fx=CLEAR_ELUDED -> GRUNT_FOUND_ENEMY
pick grunt states=COMBAT any=CAN_RANGE_ATTACK1 none=ENEMY_DEAD|NEW_ENEMY when OCCUPY_ENGAGE -> RANGE_ATTACK1
pick grunt states=COMBAT all=CAN_RANGE_ATTACK1|CAN_RANGE_ATTACK2 none=ENEMY_DEAD|NEW_ENEMY when OCCUPY_GRENADE -> RANGE_ATTACK2
pick grunt states=COMBAT any=CAN_RANGE_ATTACK1 none=ENEMY_DEAD|NEW_ENEMY -> TAKE_COVER_FROM_ENEMY
pick grunt states=COMBAT all=ENEMY_OCCLUDED|CAN_RANGE_ATTACK2 none=ENEMY_DEAD|NEW_ENEMY when OCCUPY_GRENADE -> RANGE_ATTACK2
pick grunt states=COMBAT any=ENEMY_OCCLUDED none=ENEMY_DEAD|NEW_ENEMY when OCCUPY_ENGAGE -> GRUNT_ESTABLISH_LINE_OF_FIRE
pick grunt states=COMBAT any=ENEMY_OCCLUDED none=ENEMY_DEAD|NEW_ENEMY -> STANDOFF
pick grunt states=COMBAT any=SEE_ENEMY none=ENEMY_DEAD|CAN_RANGE_ATTACK1 -> GRUNT_ESTABLISH_LINE_OF_FIRE
